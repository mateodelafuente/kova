---
/**
 * Íconos SVG en línea, todos sobre grilla de 24 y trazo (no relleno).
 * Uso: <Icon name="feed" /> · <Icon name="sun" size={20} />
 */
interface Props {
  name: string;
  size?: number;
  stroke?: number;
}
const { name, size = 24, stroke = 1.3 } = Astro.props;

const paths: Record<string, string> = {
  // Productos
  feed: '<rect x="6" y="3" width="12" height="18" rx="2"/><circle cx="12" cy="13" r="2.5"/>',
  flow: '<path d="M5 13h14v6H5z"/><path d="M12 4c2 3 4 4 4 6a4 4 0 0 1-8 0c0-2 2-3 4-6z"/>',
  play: '<circle cx="12" cy="12" r="7"/><circle cx="12" cy="12" r="2"/>',
  track: '<circle cx="12" cy="10" r="6"/><path d="M12 16v5"/><circle cx="12" cy="10" r="1.5"/>',
  // Pilares
  spark: '<path d="M13 2 4 14h7l-1 8 9-12h-7z"/>',
  gem: '<path d="M12 3 3 9l9 12 9-12z"/>',
  compass: '<circle cx="12" cy="12" r="9"/><path d="m15 9-4 1-2 5 4-1z"/>',
  shield: '<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/>',
  // UI
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>',
  moon: '<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/>',
  menu: '<path d="M3 6h18M3 12h18M3 18h18"/>',
  close: '<path d="M6 6l12 12M18 6L6 18"/>',
  arrow: '<path d="M5 12h14M13 6l6 6-6 6"/>',
  portrait: '<path d="M4 20c2-6 5-9 8-9s6 3 8 9"/><circle cx="12" cy="7" r="3"/>',
  suite: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 15l5-5 4 4 5-5 4 4"/><circle cx="9" cy="9" r="1.5"/>',
  cart: '<path d="M6 8h12l-1.1 11a2 2 0 0 1-2 1.8H9.1a2 2 0 0 1-2-1.8L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>',
};

const d = paths[name] ?? '';
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={d}
/>
