---
/**
 * Slideshow del hero: varias fotos que se van cruzando solas. Para sumar
 * una foto nueva alcanza con agregarla a `slides` — no hace falta tocar
 * el resto del componente. Todas las fotos viven en src/img/.
 */
import img1 from '../img/hero.webp';
import img2 from '../img/hero-2.webp';
import img3 from '../img/hero-3.webp';
import img4 from '../img/hero-4.webp';

const slides = [
  {
    src: img1,
    alt: 'Gato y perro golden retriever junto al comedero y la fuente inteligente KOVA Pets',
    position: '50% 22%',
  },
  {
    src: img2,
    alt: 'Gato tomando agua de la fuente inteligente KOVA Pets, junto al comedero, en un living',
    position: '50% 45%',
  },
  {
    src: img3,
    alt: 'Perro golden retriever comiendo del comedero inteligente KOVA Pets',
    position: '50% 55%',
  },
  {
    src: img4,
    alt: 'Comedero inteligente KOVA Pets junto al celular mostrando el video en vivo de un gato',
    position: '50% 38%',
  },
];
---
<div class="slideshow" data-slideshow>
  {slides.map((slide, i) => (
    <img
      src={slide.src.src}
      alt={slide.alt}
      class:list={['slideshow__slide', { 'is-active': i === 0 }]}
      style={`object-position: ${slide.position}`}
      width={slide.src.width}
      height={slide.src.height}
      loading={i === 0 ? 'eager' : 'lazy'}
      fetchpriority={i === 0 ? 'high' : 'auto'}
    />
  ))}
</div>

<style>
  .slideshow {
    position: relative;
    width: 100%;
    height: 100%;
  }
  .slideshow__slide {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.9s var(--ease);
  }
  .slideshow__slide.is-active {
    opacity: 1;
  }
</style>

<script>
  // Une varios slideshows si algún día hay más de uno en la página.
  document.querySelectorAll<HTMLElement>('[data-slideshow]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLImageElement>('.slideshow__slide'));
    if (slides.length < 2) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduceMotion) return; // se queda quieto en la primera foto

    let current = 0;
    setInterval(() => {
      slides[current].classList.remove('is-active');
      current = (current + 1) % slides.length;
      slides[current].classList.add('is-active');
    }, 3000);
  });
</script>
