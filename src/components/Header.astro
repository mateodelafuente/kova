---
/**
 * Cabecera del sitio: sólo la marca a la izquierda y, a la derecha, acceso
 * a la colección (carrito) y el switch de tono. Sin navegación de
 * productos — la colección se recorre scrolleando desde la home.
 */
import BrandMark from './BrandMark.astro';
import ThemeToggle from './ThemeToggle.astro';
import Icon from './Icon.astro';
---
<header class="header" id="site-header">
  <div class="container header__inner">
    <BrandMark />

    <div class="header__actions">
      <a href="/#coleccion" class="icon-btn" aria-label="Ver la colección">
        <Icon name="cart" size={19} />
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 0.9rem;
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
</style>
