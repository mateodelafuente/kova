---
import Icon from './Icon.astro';
import type { Product } from '../data/products';

interface Props {
  product: Product;
  /** Orden dentro de la grilla, para escalonar la animación de aparición */
  revealDelay?: number;
}
const { product, revealDelay = 0 } = Astro.props;
---
<article class="card" data-reveal data-reveal-repeat style={{ '--d': revealDelay }}>
  {product.photo ? (
    <img
      src={product.photo.src}
      alt={product.tagline}
      class="card__image"
      width={product.photo.width}
      height={product.photo.height}
      loading="lazy"
    />
  ) : (
    <div class="placeholder card__image">
      <Icon name={product.icon} size={44} />
      <span class="placeholder__label">{product.name}</span>
    </div>
  )}
  <div class="card__body">
    <h3>{product.name}</h3>
    <p class="card__desc">{product.tagline}.</p>
    <span class="card__price">{product.price ?? '[precio]'} ARS</span>
    <a href={`/productos/${product.slug}`} class="btn-ghost card__cta">Ver producto</a>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--border-soft);
  }
  .card__image {
    display: block;
    width: 100%;
    height: auto; /* si no, el atributo height del <img> gana sobre
                     aspect-ratio y cada foto queda con su alto real */
    aspect-ratio: 4 / 2.2;
    border: 0;
    border-bottom: 1px solid var(--border-soft);
    object-fit: cover;
  }
  .card__body { padding: 0.95rem 1rem 1.1rem; display: flex; flex-direction: column; gap: 0.3rem; }
  .card__body h3 { font-size: var(--step-1); }
  .card__desc { font-size: var(--step--1); color: var(--text); }
  .card__price { font-size: var(--step--1); color: var(--text-muted); margin-top: 0.2rem; }
  .card__cta { margin-top: 0.5rem; align-self: flex-start; padding: 0.6rem 1.1rem; }
</style>
