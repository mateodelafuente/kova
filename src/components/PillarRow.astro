---
/**
 * Los cuatro pilares de marca (Intelligent, Refined, Thoughtful, Trusted),
 * en una fila compacta. Vive dentro de la sección de Colección, debajo del
 * título — da el contexto de marca justo antes de mostrar los productos.
 */
import Icon from './Icon.astro';
import { pillars } from '../data/site';
---
<div class="pillar-row">
  {pillars.map((pillar) => (
    <div class="pillar">
      <Icon name={pillar.icon} size={18} />
      <div>
        <span class="pillar__name">{pillar.name.toUpperCase()}</span>
        <span class="pillar__desc">{pillar.desc}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .pillar-row {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
    padding-block: 1rem;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-block: 1px solid var(--border);
  }
  .pillar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--accent);
  }
  .pillar > div { display: flex; flex-direction: column; color: var(--text); }
  .pillar__name { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; color: var(--text-strong); }
  .pillar__desc { font-size: 0.75rem; color: var(--text-muted); }

  @media (max-width: 760px) {
    .pillar-row { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.1rem; }
  }
  @media (max-width: 480px) {
    .pillar-row { grid-template-columns: 1fr; }
  }
</style>
