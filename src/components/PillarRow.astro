---
/**
 * Los pilares de marca, en una fila compacta. Por default usa los 4
 * pilares generales (src/data/site.ts) y vive dentro de la sección de
 * Colección, debajo del título. Pasando `items` se puede reusar con
 * otra lista — por ejemplo, la página de marca suma un quinto pilar
 * (Pet Wellbeing) que sólo tiene sentido ahí.
 */
import Icon from './Icon.astro';
import { pillars, type Pillar } from '../data/site';

interface Props {
  items?: Pillar[];
}
const { items = pillars } = Astro.props;
---
<div class="pillar-row" style={`--cols: ${items.length}`}>
  {items.map((pillar, i) => (
    <div class="pillar" data-reveal data-reveal-repeat style={{ '--d': i }}>
      <Icon name={pillar.icon} size={18} />
      <div>
        <span class="pillar__name">{pillar.name.toUpperCase()}</span>
        <span class="pillar__desc">{pillar.desc}</span>
      </div>
    </div>
  ))}
</div>

<style>
  .pillar-row {
    display: grid;
    grid-template-columns: repeat(var(--cols, 4), minmax(0, 1fr));
    gap: 1.25rem;
    padding-block: 1rem;
    margin-bottom: clamp(1.5rem, 1rem + 2vw, 2.25rem);
    border-block: 1px solid var(--border);
  }
  .pillar {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--accent);
  }
  .pillar > div { display: flex; flex-direction: column; color: var(--text); }
  .pillar__name { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; color: var(--text-strong); }
  .pillar__desc { font-size: 0.75rem; color: var(--text-muted); }

  @media (max-width: 760px) {
    .pillar-row { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 1.1rem; }
  }
  @media (max-width: 480px) {
    .pillar-row { grid-template-columns: 1fr; }
  }
</style>
