---
import Icon from '../Icon.astro';
import { pillars } from '../../data/site';
---
<section class="trust">
  <div class="container trust__grid">
    {pillars.map((pillar) => (
      <div class="trust__item">
        <Icon name={pillar.icon} size={20} />
        <div>
          <span class="trust__name">{pillar.name.toUpperCase()}</span>
          <span class="trust__desc">{pillar.desc}</span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .trust { background: var(--surface); border-bottom: 1px solid var(--border); }
  .trust__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    padding-inline: 0;
  }
  .trust__item {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1.5rem clamp(1rem, 0.5rem + 1.5vw, 1.75rem);
    border-right: 1px solid var(--border-soft);
    color: var(--accent);
  }
  .trust__item:last-child { border-right: 0; }
  .trust__item > div { display: flex; flex-direction: column; color: var(--text); }
  .trust__name { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.07em; color: var(--text-strong); }
  .trust__desc { font-size: 0.75rem; color: var(--text-muted); }

  @media (max-width: 860px) {
    .trust__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .trust__item:nth-child(2) { border-right: 0; }
    .trust__item:nth-child(1),
    .trust__item:nth-child(2) { border-bottom: 1px solid var(--border-soft); }
  }
  @media (max-width: 480px) {
    .trust__grid { grid-template-columns: 1fr; }
    .trust__item { border-right: 0; border-bottom: 1px solid var(--border-soft); }
    .trust__item:last-child { border-bottom: 0; }
  }
</style>
