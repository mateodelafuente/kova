---
import { brand } from '../../data/site';
import HeroSlideshow from '../HeroSlideshow.astro';
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="eyebrow" data-reveal style={{ '--d': 0 }}>{brand.name} {brand.sub}</span>
      <h1 data-reveal style={{ '--d': 1 }}>El cuidado diario de tu mascota, mejor pensado.</h1>
      <p class="hero__lead" data-reveal style={{ '--d': 2 }}>
        Comederos, fuentes y accesorios inteligentes con diseño que querés
        tener a la vista. Tecnología con propósito, para quienes más querés.
      </p>
      <div class="hero__actions" data-reveal style={{ '--d': 3 }}>
        <a href="#coleccion" class="btn">Ver la colección</a>
        <a href="/marca" class="btn-ghost">Conocer KOVA</a>
      </div>
    </div>

    <div class="hero__image-frame" data-reveal style={{ '--d': 1 }}>
      <HeroSlideshow />
    </div>
  </div>
</section>

<!-- Firma sutil de la submarca: presente, sin competir con el titular -->
<div class="signature-band">
  <div class="container signature-band__inner">
    <p class="signature">{brand.tagline}</p>
  </div>
</div>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    padding-block: clamp(0.75rem, 0.4rem + 1.2vw, 1.35rem);
  }

  .hero__copy { display: flex; flex-direction: column; gap: 0.65rem; }
  .hero__copy h1 { font-size: var(--step-4); font-weight: 600; }
  .hero__lead { max-width: 30rem; font-size: var(--step-0); }
  .hero__actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 0.1rem; }

  /* El marco recorta el slideshow que vive adentro. */
  .hero__image-frame {
    width: 100%;
    min-width: 0; /* evita que la imagen empuje la columna del grid */
    aspect-ratio: 5 / 3;
    min-height: 8rem;
    overflow: hidden;
  }

  .signature-band {
    border-block: 1px solid var(--border);
  }
  .signature-band__inner {
    display: flex;
    justify-content: flex-end;
    padding-block: 0.3rem;
  }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__image-frame { aspect-ratio: 16 / 8; min-height: 9rem; }
  }
</style>
