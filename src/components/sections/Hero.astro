---
import { brand } from '../../data/site';
/**
 * La foto vive optimizada (WebP) en public/img/hero.webp — servida tal
 * cual, sin pasar por el pipeline de imágenes de Astro. El original
 * editable (recorte + retoque de color) queda en src/img/hero.jpg.
 */
---
<section class="hero">
  <div class="container hero__grid">
    <div class="hero__copy">
      <span class="eyebrow">{brand.name} {brand.sub}</span>
      <h1>El cuidado diario de tu mascota, mejor pensado.</h1>
      <p class="hero__lead">
        Comederos, fuentes y accesorios inteligentes con diseño que querés
        tener a la vista. Tecnología con propósito, para quienes más querés.
      </p>
      <div class="hero__actions">
        <a href="#coleccion" class="btn">Ver la colección</a>
        <a href="/marca" class="btn-ghost">Conocer KOVA</a>
      </div>
    </div>

    <img
      src="/img/hero.webp"
      alt="Gato y perro golden retriever junto al comedero y la fuente inteligente KOVA Pets"
      class="hero__image"
      width="1024"
      height="612"
      loading="eager"
      fetchpriority="high"
    />
  </div>
</section>

<!-- Firma sutil de la submarca: presente, sin competir con el titular -->
<div class="signature-band">
  <div class="container signature-band__inner">
    <p class="signature">{brand.tagline}</p>
  </div>
</div>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: clamp(1.25rem, 0.75rem + 1.5vw, 2rem);
    padding-block: clamp(0.75rem, 0.4rem + 1.2vw, 1.35rem);
  }

  .hero__copy { display: flex; flex-direction: column; gap: 0.65rem; }
  .hero__copy h1 { font-size: var(--step-4); font-weight: 600; }
  .hero__lead { max-width: 30rem; font-size: var(--step-0); }
  .hero__actions { display: flex; gap: 0.9rem; flex-wrap: wrap; margin-top: 0.1rem; }

  .hero__image {
    display: block;
    width: 100%;
    height: auto; /* sin esto, el atributo height="612" del <img> gana y
                     desarma el recuadro — aspect-ratio necesita height:auto
                     para poder calcular el alto a partir del ancho real. */
    min-width: 0;  /* evita que la imagen empuje la columna del grid */
    aspect-ratio: 5 / 3;
    min-height: 8rem;
    object-fit: cover;
    object-position: 50% 22%;
  }

  .signature-band {
    border-block: 1px solid var(--border);
  }
  .signature-band__inner {
    display: flex;
    justify-content: flex-end;
    padding-block: 0.3rem;
  }

  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__image { aspect-ratio: 16 / 8; min-height: 9rem; }
  }
</style>
