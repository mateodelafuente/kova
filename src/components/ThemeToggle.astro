---
/**
 * Switch para cambiar el tono claro / oscuro: una píldora con un círculo
 * que se desliza de lado a lado y muestra el ícono del modo activo.
 * El tema se guarda en localStorage y se aplica antes de pintar la página
 * (ver el script inline en BaseLayout.astro) para que no haya "parpadeo".
 */
import Icon from './Icon.astro';
---
<button
  type="button"
  class="theme-toggle"
  id="theme-toggle"
  role="switch"
  aria-checked="false"
  aria-label="Cambiar tono claro u oscuro"
  title="Cambiar tono"
>
  <span class="theme-toggle__track">
    <span class="theme-toggle__thumb">
      <span class="theme-toggle__icon theme-toggle__icon--sun"><Icon name="sun" size={12} stroke={1.8} /></span>
      <span class="theme-toggle__icon theme-toggle__icon--moon"><Icon name="moon" size={12} stroke={1.8} /></span>
    </span>
  </span>
</button>

<style>
  .theme-toggle {
    display: inline-flex;
    padding: 0;
    cursor: pointer;
  }

  .theme-toggle__track {
    position: relative;
    display: flex;
    align-items: center;
    width: 3.35rem;
    height: 1.85rem;
    padding: 0.18rem;
    border: 1px solid color-mix(in srgb, var(--text) 35%, transparent);
    border-radius: 999px;
    background: var(--surface-alt);
    transition: border-color 0.2s var(--ease), background-color 0.2s var(--ease),
      transform 0.15s var(--ease);
  }
  .theme-toggle:hover .theme-toggle__track { border-color: var(--accent); }
  .theme-toggle:active .theme-toggle__track { transform: scale(0.96); }

  .theme-toggle__thumb {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.45rem;
    height: 1.45rem;
    border-radius: 50%;
    background: var(--accent);
    color: var(--kova-carbon);
    box-shadow: 0 2px 6px color-mix(in srgb, var(--kova-carbon) 30%, transparent);
    transform: translateX(0);
    transition: transform 0.35s var(--ease);
  }
  :global([data-theme='dark']) .theme-toggle__thumb {
    transform: translateX(1.54rem);
  }

  .theme-toggle__icon {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 1;
    transform: rotate(0deg) scale(1);
    transition: opacity 0.25s var(--ease), transform 0.35s var(--ease);
  }
  .theme-toggle__icon--moon { opacity: 0; transform: rotate(80deg) scale(0.4); }
  :global([data-theme='dark']) .theme-toggle__icon--sun { opacity: 0; transform: rotate(-80deg) scale(0.4); }
  :global([data-theme='dark']) .theme-toggle__icon--moon { opacity: 1; transform: rotate(0deg) scale(1); }
</style>

<script>
  const btn = document.getElementById('theme-toggle');

  function sync() {
    const dark = document.documentElement.dataset.theme === 'dark';
    btn?.setAttribute('aria-checked', String(dark));
  }
  sync();

  btn?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('kova-theme', next);
    } catch (e) {
      /* almacenamiento no disponible — el cambio igual aplica en esta visita */
    }
    sync();
  });
</script>
