---
/**
 * Drawer de universos: se abre desde el botón "Universos" del header.
 * Panel a pantalla completa que entra desde la izquierda. Cada universo
 * disponible lleva a su catálogo (/productos con filtros); los que todavía
 * no están aparecen en gris con "Próximamente".
 *
 * Se monta en BaseLayout (no dentro del <header>): el backdrop-filter del
 * header crea un containing block y le rompería el position:fixed.
 */
import Icon from './Icon.astro';
import { universes } from '../data/site';
---
<div class="nav-drawer" id="nav-drawer" data-drawer>
  <div class="nav-drawer__backdrop" data-drawer-close></div>

  <aside class="nav-drawer__panel" role="dialog" aria-modal="true" aria-label="Universos KOVA">
    <div class="nav-drawer__head">
      <span class="nav-drawer__title">Universos</span>
      <button type="button" class="nav-drawer__close" aria-label="Cerrar" data-drawer-close>
        <Icon name="close" size={20} />
      </button>
    </div>

    <nav class="nav-drawer__body">
      {universes.map((u) => (
        <div class:list={['uni', { 'uni--soon': !u.active }]}>
          <div class="uni__row">
            <span class="uni__name">{u.name}</span>
            <span class="uni__status">{u.status}</span>
          </div>
          {u.active && (
            <a class="uni__cta" href={`/productos?u=${u.slug}`}>
              Ver productos
              <Icon name="arrow" size={16} />
            </a>
          )}
        </div>
      ))}
    </nav>

    <div class="nav-drawer__foot">
      <a href="/marca" class="nav-drawer__foot-link">Conocer KOVA</a>
    </div>
  </aside>
</div>

<script>
  const drawer = document.getElementById('nav-drawer');
  if (drawer) {
    const opener = document.querySelector<HTMLElement>('[data-drawer-open]');
    const closeEls = drawer.querySelectorAll<HTMLElement>('[data-drawer-close]');
    const closeBtn = drawer.querySelector<HTMLElement>('.nav-drawer__close');

    const open = () => {
      drawer.classList.add('is-open');
      document.documentElement.classList.add('drawer-open');
      opener?.setAttribute('aria-expanded', 'true');
      closeBtn?.focus();
    };
    const close = () => {
      drawer.classList.remove('is-open');
      document.documentElement.classList.remove('drawer-open');
      opener?.setAttribute('aria-expanded', 'false');
      opener?.focus();
    };

    opener?.addEventListener('click', open);
    closeEls.forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && drawer.classList.contains('is-open')) close();
    });
  }
</script>

<style>
  /* Siempre en el DOM; invisible y sin capturar clicks hasta abrirse.
     Sin JS el botón no hace nada — el sitio ya depende de JS igual. */
  .nav-drawer {
    position: fixed;
    inset: 0;
    z-index: 100;
    visibility: hidden;
    pointer-events: none;
  }
  .nav-drawer.is-open {
    visibility: visible;
    pointer-events: auto;
  }

  .nav-drawer__backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, var(--kova-carbon) 55%, transparent);
    opacity: 0;
    transition: opacity 0.3s var(--ease);
  }
  .nav-drawer.is-open .nav-drawer__backdrop { opacity: 1; }

  .nav-drawer__panel {
    position: absolute;
    inset: 0 auto 0 0;
    width: min(380px, 86vw);
    display: flex;
    flex-direction: column;
    background: var(--bg);
    border-right: 1px solid var(--border);
    box-shadow: 24px 0 60px -30px color-mix(in srgb, var(--kova-carbon) 60%, transparent);
    transform: translateX(-100%);
    transition: transform 0.34s var(--ease);
    overflow-y: auto;
  }
  .nav-drawer.is-open .nav-drawer__panel { transform: translateX(0); }

  .nav-drawer__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.15rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }
  .nav-drawer__title {
    font-size: var(--step--1);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-muted);
  }
  .nav-drawer__close {
    display: inline-flex;
    padding: 0.25rem;
    color: var(--text-strong);
    transition: color 0.2s var(--ease), transform 0.2s var(--ease);
  }
  .nav-drawer__close:hover { color: var(--accent); transform: rotate(90deg); }

  .nav-drawer__body { flex: 1; padding: 0.5rem 0; }

  .uni {
    padding: 1.1rem 1.5rem;
    border-bottom: 1px solid var(--border-soft);
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  .uni__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
  }
  .uni__name {
    font-family: var(--font-serif);
    font-size: var(--step-1);
    letter-spacing: 0.08em;
    color: var(--text-strong);
  }
  .uni--soon .uni__name { color: var(--text-muted); }
  .uni__status {
    font-size: 0.625rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }
  .uni--soon .uni__status { color: var(--accent); }

  .uni__cta {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: var(--step--1);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-strong);
    transition: color 0.2s var(--ease), gap 0.2s var(--ease);
  }
  .uni__cta:hover,
  .uni__cta:focus-visible { color: var(--accent); gap: 0.7rem; }

  .nav-drawer__foot {
    padding: 1.1rem 1.5rem;
    border-top: 1px solid var(--border);
  }
  .nav-drawer__foot-link {
    font-size: var(--step--1);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    font-weight: 600;
    color: var(--text-strong);
    transition: color 0.2s var(--ease);
  }
  .nav-drawer__foot-link:hover { color: var(--accent); }
</style>
