---
/**
 * Grilla con toda la colección. Es el destino de "Ver todo" desde la home.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import { products } from '../../data/products';
---
<BaseLayout title="Colección" description="Toda la colección KOVA PETS — comederos, fuentes y accesorios inteligentes.">
  <section class="section">
    <div class="container">
      <span class="eyebrow">KOVA PETS</span>
      <h1 class="prods__title">La colección</h1>
      <p class="prods__lead">Cuatro productos, un sistema.</p>

      <div class="prods__grid">
        {products.map((p, i) => <ProductCard product={p} revealDelay={i} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .prods__title { font-size: var(--step-3); font-weight: 500; margin-top: 0.4rem; }
  .prods__lead { font-size: var(--step-0); color: var(--text-muted); margin-top: 0.4rem; }
  .prods__grid {
    margin-top: clamp(1.5rem, 1rem + 3vw, 2.5rem);
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.25rem;
  }
  @media (max-width: 960px) { .prods__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .prods__grid { grid-template-columns: 1fr; } }
</style>
