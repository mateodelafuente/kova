---
/**
 * Ficha de producto: /productos/<slug>. Una página por producto, generada
 * desde src/data/products.ts. Foto grande + specs (con valores "[a completar]"
 * hasta que el cliente pase los datos) + productos relacionados.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import { products, productsByUniverse } from '../../data/products';

export function getStaticPaths() {
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const related = productsByUniverse(product.universe).filter((p) => p.slug !== product.slug);
---
<BaseLayout
  title={product.name}
  description={`${product.name} — ${product.tagline}. ${product.description}`}
>
  <section class="section pdp">
    <div class="container">
      <nav class="pdp__crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <a href="/productos">Colección</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page">{product.name}</span>
      </nav>

      <div class="pdp__grid">
        <div class="pdp__media">
          {product.photo ? (
            <img
              src={product.photo.src}
              width={product.photo.width}
              height={product.photo.height}
              alt={product.tagline}
            />
          ) : (
            <div class="placeholder pdp__ph">
              <Icon name={product.icon} size={64} />
              <span class="placeholder__label">{product.name}</span>
            </div>
          )}
        </div>

        <div class="pdp__info">
          <span class="eyebrow">KOVA PETS</span>
          <h1 class="pdp__name">{product.name}</h1>
          <p class="pdp__tagline">{product.tagline}</p>
          <p class="pdp__price">{product.price ?? '[precio]'} ARS</p>
          <p class="pdp__desc">{product.description}</p>

          <div class="pdp__actions">
            <button type="button" class="btn" data-add-to-cart>Agregar al carrito</button>
            <a href="/carrito" class="btn-ghost">Ver carrito</a>
          </div>
          <p class="pdp__note">
            Compra online próximamente. Escribinos por WhatsApp para reservar.
          </p>
        </div>
      </div>

      <div class="pdp__details">
        <section class="pdp__block">
          <h2>Especificaciones</h2>
          <dl class="spec-list">
            {product.specs.map((s) => (
              <div class="spec-list__row">
                <dt>{s.label}</dt>
                <dd>{s.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="pdp__block">
          <h2>En detalle</h2>
          <p class="pdp__long">
            [a completar — descripción larga del producto: materiales,
            terminaciones, cómo se usa en el día a día y qué lo hace parte del
            sistema KOVA.]
          </p>
        </section>
      </div>

      {related.length > 0 && (
        <div class="pdp__related">
          <h2>Seguir explorando</h2>
          <div class="pdp__related-grid">
            {related.map((p, i) => <ProductCard product={p} revealDelay={i} />)}
          </div>
        </div>
      )}
    </div>
  </section>
</BaseLayout>

<script>
  // Sin lógica de carrito todavía: el botón sólo confirma visualmente.
  document.querySelectorAll<HTMLButtonElement>('[data-add-to-cart]').forEach((btn) => {
    const original = btn.textContent;
    btn.addEventListener('click', () => {
      btn.textContent = 'Próximamente';
      btn.disabled = true;
      setTimeout(() => {
        btn.textContent = original;
        btn.disabled = false;
      }, 1800);
    });
  });
</script>

<style>
  .pdp__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    font-size: var(--step--1);
    color: var(--text-muted);
    margin-bottom: clamp(1.25rem, 1rem + 1.5vw, 2rem);
  }
  .pdp__crumbs a:hover { color: var(--accent); }
  .pdp__crumbs [aria-current='page'] { color: var(--text); }

  .pdp__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 1rem + 4vw, 4rem);
    align-items: start;
  }
  .pdp__media {
    position: sticky;
    top: 5.5rem;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--border-soft);
    background: var(--surface);
  }
  .pdp__media img { width: 100%; height: 100%; object-fit: cover; }
  .pdp__ph { width: 100%; height: 100%; }

  .pdp__info { display: flex; flex-direction: column; gap: 0.55rem; }
  .pdp__name { font-size: var(--step-3); font-weight: 500; }
  .pdp__tagline { font-size: var(--step-1); color: var(--text); }
  .pdp__price { font-size: var(--step-0); color: var(--text-muted); margin-top: 0.3rem; }
  .pdp__desc { font-size: var(--step-0); line-height: 1.7; margin-top: 0.4rem; max-width: 32rem; }
  .pdp__actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1rem; }
  .pdp__note { font-size: var(--step--1); color: var(--text-muted); margin-top: 0.5rem; }

  .pdp__details {
    margin-top: clamp(2rem, 1rem + 4vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 1rem + 4vw, 3.5rem);
  }
  .pdp__block h2 {
    font-size: var(--step-1);
    font-weight: 600;
    margin-bottom: 1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--border);
  }
  .pdp__long { font-size: var(--step-0); line-height: 1.75; color: var(--text-muted); }

  .spec-list { display: flex; flex-direction: column; }
  .spec-list__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--border-soft);
    font-size: var(--step--1);
  }
  .spec-list__row dt { color: var(--text-muted); }
  .spec-list__row dd { margin: 0; color: var(--text); }

  .pdp__related { margin-top: clamp(2.5rem, 1.5rem + 5vw, 4.5rem); }
  .pdp__related h2 {
    font-size: var(--step-2);
    font-weight: 600;
    margin-bottom: 1.4rem;
  }
  .pdp__related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }

  @media (max-width: 900px) {
    .pdp__grid { grid-template-columns: 1fr; }
    .pdp__media { position: static; }
    .pdp__details { grid-template-columns: 1fr; }
    .pdp__related-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 520px) {
    .pdp__related-grid { grid-template-columns: 1fr; }
  }
</style>
