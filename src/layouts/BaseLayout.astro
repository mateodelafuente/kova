---
/**
 * Layout base: <html>/<head> comunes, fuentes, tema, header y footer.
 * Cada página envuelve su contenido en este layout.
 */
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'KOVA — Designed for everyday luxury. Tecnología y diseño para el cuidado cotidiano de quienes más querés.',
} = Astro.props;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title} · KOVA</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600&family=Manrope:wght@300;400;500;600;700&display=swap"
    />

    <!--
      Marca <html class="js"> ANTES de pintar la página — las animaciones de
      aparición (global.css, [data-reveal]) sólo se activan con esa clase,
      así que sin JavaScript el contenido nunca queda escondido esperando
      una animación que no va a pasar.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a href="#main" class="visually-hidden">Saltar al contenido</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <!--
      Anima cualquier [data-reveal] al entrar en pantalla (incluido lo que ya
      está visible al cargar, como el hero) — por default una sola vez por
      visita. Los que además tienen [data-reveal-repeat] (la colección para
      abajo) se esconden de nuevo al salir de pantalla, así que repiten la
      animación si el visitante sube y vuelve a bajar. Sin IntersectionObserver,
      aparece todo directo y fijo.
    -->
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) {
          els.forEach(function (el) { el.classList.add('is-visible'); });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              var el = entry.target;
              var repeats = el.hasAttribute('data-reveal-repeat');
              if (entry.isIntersecting) {
                el.classList.add('is-visible');
                if (!repeats) io.unobserve(el);
              } else if (repeats) {
                el.classList.remove('is-visible');
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        els.forEach(function (el) { io.observe(el); });
      })();
    </script>
  </body>
</html>
